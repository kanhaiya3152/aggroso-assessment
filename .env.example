# Database Persistence (MongoDB Atlas or local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/release_brief_assistant?retryWrites=true&w=majority
# Optional: use when the network's DNS resolver refuses MongoDB SRV lookups.
# MONGODB_DNS_SERVERS=1.1.1.1

# AI / LLM Provider (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
